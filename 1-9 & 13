#6Create an R list containing vectors, matrices and functions
v<-c(10,20,30,40)
m<-matrix(1:9,nrow=3)
square<-function(x){
  return(x*x)
}
mylist<-list(
  Vector=v,
  Matrix=m,
  Function=square
)
print(mylist)
print(mylist$Vector)
print(mylist$Matrix)
print(mylist$Function(5))

#7Factors of a number, random integers and FizzBuzz
n<-24
factor<-c()
for(i in 1:n){
  if(n%%i==0){
    factor<-c(factor,i)
  }
}
print(factor)
x<-sample(-50:50,10)
print(x)
for(i in 1:100){
  if(i%%15==0){
    print("FizzBuzz")
  }else if(i%%5==0){
    print("Fizz")
  }else if(i%%3==0){
    print("Buzz")
  }else{
    print(i)
  }
}

