#21 Split Iris 80/20, logistic regression, prediction and confusion matrix
set.seed(123)
data <- iris
data$Species <- ifelse(
  data$Species == "setosa",
  "setosa",
  "non-setosa"
)
data$Species <- factor(data$Species)
n <- nrow(data)
train_index <- sample(
  1:n,
  size=0.8*n
)
train <- data[train_index,]
test <- data[-train_index,]
model <- glm(
  Species ~ Petal.Length + Petal.Width,
  data=train,
  family=binomial
)
summary(model)
prob <- predict(
  model,
  newdata=test,
  type="response"
)
pred <- ifelse(
  prob > 0.5,
  "setosa",
  "non-setosa"
)
pred <- factor(
  pred,
  levels=levels(test$Species)
)
confusion_matrix <- table(
  Actual=test$Species,
  Predicted=pred
)
accuracy <- sum(diag(confusion_matrix)) /
  sum(confusion_matrix)
print(accuracy)
print(confusion_matrix)
cat("Accuracy =", accuracy, "\n")
print(confusion_matrix)

